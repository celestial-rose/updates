# Example .env file for local development
# Copy this to .env and fill in the values

# Although secrets are better managed via `wrangler secret put`
# you can use .dev.vars for local development
EXPO_UPDATES_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."

# The absolute path to your Expo project(s) root directory.
# This is used by the publish script to locate your project.
# You can specify multiple paths separated by commas.
EXPO_PROJECT_PATHS=/path/to/project-a,/path/to/project-b